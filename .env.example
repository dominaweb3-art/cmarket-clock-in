# Safe development configuration template.
# Use Devnet values only during the hackathon prototype.

EXPO_PUBLIC_SOLANA_CLUSTER=devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_DEVNET_USDC_MINT=REPLACE_WITH_DEVNET_USDC_MINT
EXPO_PUBLIC_DEVNET_TREASURY_PUBLIC_KEY=REPLACE_WITH_DEVNET_TREASURY_PUBLIC_KEY

# Never put private keys, seed phrases, wallet exports, or signing secrets here.
