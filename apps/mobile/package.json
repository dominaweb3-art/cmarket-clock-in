{
  "name": "cmarket-mobile",
  "scripts": {
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "android:export": "NODE_ENV=production expo export --platform android --output-dir dist/release-check --clear",
    "android:release:validate": "NODE_ENV=production expo prebuild --platform android --clean --no-install && cd android && NODE_ENV=production ./gradlew assembleRelease",
    "build": "tsc --noEmit && npm run android:build",
    "c3:core:mainnet:build-simulate": "node --experimental-strip-types ./scripts/c3-core-mainnet-build-simulation.mjs",
    "c3:core:mainnet-preflight": "node ./scripts/c3-core-mainnet-feasibility-preflight.mjs",
    "test:c3-core-mainnet": "node --experimental-strip-types ./scripts/c3-core-mainnet-engine.test.ts",
    "test:c3-core-mainnet-security": "node --experimental-strip-types ./scripts/c3-core-mainnet-reconciliation-security.test.ts",
    "test:c3-core-mainnet-recovery": "node --experimental-strip-types ./scripts/c3-core-mainnet-recovery.test.ts",
    "test:c3-core-mainnet-capability": "node ./scripts/c3-core-mainnet-capability.test.mjs",
    "test:devnet-bundle-isolation": "node ./scripts/devnet-bundle-isolation.mjs",
    "test:spl-token-compat": "node --experimental-strip-types ./scripts/spl-token-compatible.security.test.ts",
    "c3:preflight": "node ./scripts/c3-devnet-feasibility-preflight.mjs",
    "ci": "tsc --noEmit && npm run lint:check && npm run format:check && npm run android:build",
    "dev": "expo start",
    "doctor": "npx -y expo-doctor@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo run:ios",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "release:android:apk": "NODE_ENV=production npx --yes eas-cli@24.4.0 build --platform android --profile release-apk --local",
    "release:android:apk:local": "./scripts/build-local-signed-apk.sh",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "displayName": "C Market",
  "description": "A Solana Mobile basket prototype for the CLOCK IN hackathon.",
  "usecase": "Mobile",
  "keywords": [
    "expo",
    "mobile-wallet-adapter",
    "react-native",
    "solana-web3js",
    "wallet",
    "wallet-ui"
  ],
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-snackbar"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "main": "./index.js",
  "version": "0.1.0",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@solana/web3.js": "^1.99.0",
    "@tanstack/react-query": "^5.102.8",
    "@wallet-ui/react-native-web3js": "^4.3.0",
    "color": "^4.2.3",
    "expo": "~57.0.23",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "js-base64": "^3.9.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-snackbar": "^2.9.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-qr-code": "2.0.18"
  },
  "devDependencies": {
    "@types/color": "^4.2.1",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
