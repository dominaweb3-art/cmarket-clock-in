{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "api/health.mjs": { "maxDuration": 30, "includeFiles": "certs/*.crt" },
    "api/evaluation.mjs": {
      "maxDuration": 45,
      "includeFiles": "{certs/*.crt,resources/*.json}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        }
      ]
    }
  ]
}
