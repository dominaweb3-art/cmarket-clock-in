{
  "name": "@cmarket/c3-mainnet-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint src scripts tests research pilot-open-local",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:postgres": "node scripts/test-postgres-local.mjs",
    "test:open-local-postgres": "node scripts/test-postgres-local.mjs --open-local",
    "test:open-local-cpi-postgres": "node scripts/test-postgres-local.mjs --open-local-cpi",
    "test:open-v0-measure": "node --experimental-strip-types --test pilot-open-local/jupiter-v0-measure.test.ts",
    "test:accounting": "node --experimental-strip-types --test tests/accounting.test.ts",
    "test:security": "node --experimental-strip-types --test tests/security.test.ts",
    "test:keeper": "node --experimental-strip-types --test tests/keeper.test.ts",
    "test:boundary": "npm run build && node --test tests/export-boundary.test.mjs",
    "test:symmetry-research": "node --experimental-strip-types --test research/symmetry-v3/*.test.ts",
    "c3:symmetry:integration-readiness": "node --experimental-strip-types research/symmetry-v3/integration-readiness.ts",
    "c3:symmetry:builder-readiness": "node --experimental-strip-types ../c3-symmetry-builder/scripts/readiness.mjs",
    "test:governance": "node --test tests/governance-readiness.test.mjs",
    "c3:governance:readiness": "node scripts/governance-readiness.mjs",
    "c3:oracle:readiness": "node scripts/oracle-readiness.mjs",
    "test:oracle-nav": "node --experimental-strip-types --test research/oracle-nav/*.test.ts",
    "c3:oracle:evidence": "node --experimental-strip-types research/oracle-nav/pyth-evidence-cli.ts",
    "c3:mainnet:builder-readiness": "node --experimental-strip-types scripts/readiness.ts builder",
    "c3:mainnet:keeper-readiness": "node --experimental-strip-types scripts/readiness.ts keeper",
    "c3:mainnet:deployment-readiness": "node --experimental-strip-types scripts/readiness.ts deployment",
    "c3:jupiter:pilot-preflight": "node --experimental-strip-types scripts/jupiter-pilot-preflight.ts",
    "c3:jupiter:v0-six-route-probe": "node --experimental-strip-types scripts/jupiter-v0-six-route-probe.ts",
    "c3:jupiter:vault-cpi-preflight": "node --experimental-strip-types scripts/jupiter-vault-cpi-preflight.ts",
    "test:open-cpi-inspection": "node --experimental-strip-types --test pilot-open-local/jupiter-vault-cpi-inspection.test.ts",
    "test:jupiter-fork-probe": "node --experimental-strip-types pilot-open-local/jupiter-fork-probe.ts",
    "test:jupiter-six-clone": "node --experimental-strip-types pilot-open-local/jupiter-six-clone.ts",
    "test:open-quote-postgres": "node scripts/test-postgres-local.mjs --open-quote",
    "test:open-jupiter-recovery": "node scripts/test-postgres-local.mjs --open-jupiter-recovery",
    "c3:open:read-server": "node --experimental-strip-types pilot-open-local/read-server-cli.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/web3.js": "1.99.0",
    "@types/bn.js": "5.2.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "pg": "8.23.0"
  }
}
