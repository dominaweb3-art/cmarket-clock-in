{
  "name": "@cmarket/c3-mainnet-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint src scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:accounting": "node --experimental-strip-types --test tests/accounting.test.ts",
    "test:security": "node --experimental-strip-types --test tests/security.test.ts",
    "test:keeper": "node --experimental-strip-types --test tests/keeper.test.ts",
    "c3:mainnet:builder-readiness": "node --experimental-strip-types scripts/readiness.ts builder",
    "c3:mainnet:keeper-readiness": "node --experimental-strip-types scripts/readiness.ts keeper",
    "c3:mainnet:deployment-readiness": "node --experimental-strip-types scripts/readiness.ts deployment"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
